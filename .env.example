# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project "Leander3T" (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://mbpinvgomfjmbpwyqaiv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses row-level security — used only in server actions and
# route handlers (order-form generation, public request-info form).
SUPABASE_SERVICE_ROLE_KEY=

# Resend (order-form and notification email), added in M6. Until both are set,
# order forms still generate and wait in Order Forms; the review-team email is
# skipped. The sender must be on a domain verified in Resend.
RESEND_API_KEY=
ORDER_FORMS_FROM="Leander 3T <orders@leander3t.com>"
